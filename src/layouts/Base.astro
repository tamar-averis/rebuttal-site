---
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import ConsentBanner from '../components/site/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  page?: string;
  noindex?: boolean;
}

const { title, description, page, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Consent Mode v2 defaults. Must run before the GTM snippet below: tags
         read the consent state at load, so a default set afterwards is a default
         that arrived too late. Everything measurement-related starts denied, and
         a returning visitor's stored Accept is replayed here so their choice
         survives a reload. functionality and security storage stay granted —
         neither tracks anyone, and denying them breaks the site. -->
    <script is:inline>
      (function () {
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;

        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 500,
        });

        try {
          if (localStorage.getItem('rebuttal-cookie-consent') === 'accepted') {
            gtag('consent', 'update', {
              ad_storage: 'granted',
              ad_user_data: 'granted',
              ad_personalization: 'granted',
              analytics_storage: 'granted',
            });
          }
        } catch (e) {}
      })();
    </script>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-XXXXXXX' /* PLACEHOLDER — create a Rebuttal GTM container and replace */);
    </script>
    <!-- End Google Tag Manager -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-XXXXXXX"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <Header page={page} />
    <main>
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script is:inline>
      // Google Ads click ID, stored on arrival because visitors usually land on
      // one page and submit on another later.
      (function () {
        var m = location.search.match(/[?&]gclid=([^&]+)/);
        if (m) {
          try {
            localStorage.setItem('gclid', JSON.stringify({ v: decodeURIComponent(m[1]), t: Date.now() }));
          } catch (e) {}
        }
      })();
    </script>
    <script is:inline>
      // Legacy hash routes carried over from the prototype. The query string is
      // carried across so gclid and utm_* survive the redirect.
      (function () {
        if (location.pathname !== '/') return;
        var map = {
          '#evidence': '/how-it-works',
          '#method': '/how-it-works',
          '#about': '/about',
          '#contact': '/contact',
        };
        var target = map[location.hash];
        if (target) location.replace(target + location.search);
      })();
    </script>
  </body>
</html>
