---
import Base from './Base.astro';
import PageHero from '../components/site/PageHero.astro';
import Card from '../components/core/Card.astro';

interface Section {
  id: string;
  title: string;
  /** Raw HTML for the section body — legal copy is static, so this is written directly. */
  body: string;
}

interface Props {
  title: string;
  description: string;
  updated: string;
  sections: Section[];
}

const { title, description, updated, sections } = Astro.props;
---

<Base title={`Rebuttal, ${title}`} description={description}>
  <PageHero eyebrow="Legal" title={title}>
    <p class="rb-sub">{description}</p>
    <p class="small" style="margin-top:24px">Last updated {updated}</p>
  </PageHero>
  <section class="rb-sec cream">
    <div class="rb-wrap rb-legal">
      <nav class="rb-toc" aria-label="On this page" data-legal-toc>
        <div class="eyebrow" style="margin-bottom:12px">On this page</div>
        {sections.map((s) => <a href={`#${s.id}`} data-toc-link={s.id}>{s.title}</a>)}
      </nav>
      <div class="rb-legal-body">
        {
          sections.map((s) => (
            <section id={s.id} class="rb-legal-sec">
              <h2 class="rb-h3">{s.title}</h2>
              <Fragment set:html={s.body} />
            </section>
          ))
        }
        <Card variant="flat" padding={24} style="margin-top:56px">
          <p style="font-size:16px;line-height:1.55;color:var(--fg-muted)">
            <strong style="color:var(--fg)">Draft for counsel review.</strong> This document is a structural and
            editorial template written to the Rebuttal brand voice. It is not legal advice and has not been reviewed by
            an attorney. Have counsel confirm every clause, jurisdiction, retention period, and statutory reference
            before publication.
          </p>
        </Card>
      </div>
    </div>
  </section>
</Base>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const sections = links
    .map((l) => document.getElementById(l.dataset.tocLink!))
    .filter((el): el is HTMLElement => !!el);

  const setActive = () => {
    let current = sections[0];
    for (const el of sections) {
      if (el.getBoundingClientRect().top < 160) current = el;
    }
    links.forEach((l) => {
      if (l.dataset.tocLink === current?.id) {
        l.setAttribute('aria-current', 'true');
      } else {
        l.removeAttribute('aria-current');
      }
    });
  };

  links.forEach((l) => {
    l.addEventListener('click', (e) => {
      e.preventDefault();
      const el = document.getElementById(l.dataset.tocLink!);
      if (el) {
        window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 112, behavior: 'smooth' });
      }
    });
  });

  window.addEventListener('scroll', setActive, { passive: true });
  setActive();
</script>
