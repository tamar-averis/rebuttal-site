---
import Base from '../layouts/Base.astro';
import PageHero from '../components/site/PageHero.astro';
import CtaBand from '../components/site/CtaBand.astro';
import Tag from '../components/core/Tag.astro';

const FOCUS: string[] = [
  'Zero-paid adjudications',
  'Misclassified claims',
  '\u201cMember not found\u201d errors',
  'Claims stuck in pending review',
  'Unadjudicated claims in limbo',
  'Inconsistencies between 837 (submitted) and 835 (paid) data',
  'Payer patterns that hide collectible revenue',
];

const DELIVER: string[] = [
  'AR Recovery Audits',
  'Payer Forensics (835/837 deep dives)',
  'Demand Letters & CRN Preparation',
  'Litigation Support Packages',
  'Complete AR Recovery Roadmaps',
];

const TEAM: [string, string, string, string][] = [
  ['/assets/tamar-schapira.jpg', 'Co-founder & CEO', 'Tamar Schapira', 'Two decades in healthcare compliance and claims strategy. Tamar runs provider relationships and the practitioner calibration that grounds every AR recovery engagement.'],
  ['/assets/nadav-bernstein.jpg', 'Co-founder, CPO & SME', 'Nadav Bernstein', 'Former engineering lead on claims analytics platforms at scale. Nadav owns the data pipeline, payer forensics tooling, and the 835/837 reconciliation engine.'],
];
---

<Base
  title="Rebuttal, About"
  description="Rebuttal exists because the money a provider is owed is recoverable, and because the record almost always supports the provider once someone reads all of it."
  page="about"
>
  <PageHero eyebrow="Why Rebuttal" title="Built by people who have already done the work." wide>
    <p class="rb-sub">
      Rebuttal exists because the money a provider is owed is recoverable, and because the record almost always
      supports the provider once someone reads all of it.
    </p>
  </PageHero>

  <section class="rb-sec cream">
    <div class="rb-wrap rb-split">
      <div>
        <div class="eyebrow">Background</div>
        <h2 class="rb-h2">A track record before a launch.</h2>
      </div>
      <div>
        <p class="rb-body">
          Before formally launching Rebuttal, we spent the past year supporting clinics, attorneys, and medical
          practices involved in complex payer disputes. This included building AR analysis packages that
          contributed to a recent successful court outcome against a major national healthcare payer, where our
          findings played a key role in clarifying the provider&rsquo;s position.
        </p>
        <div class="rb-tags" style="margin-top:22px">
          <Tag>Clinics</Tag>
          <Tag>Attorneys</Tag>
          <Tag>Medical practices</Tag>
          <Tag>Complex payer disputes</Tag>
        </div>
      </div>
    </div>
  </section>

  <section class="rb-sec white">
    <div class="rb-wrap">
      <div class="eyebrow">Who we are</div>
      <h2 class="rb-h2">Built by practitioners who have done the work.</h2>
      <div class="rb-team">
        {
          TEAM.map(([photo, role, name, bio]) => (
            <div class="rb-person">
              <div class="rb-person-photo"><img src={photo} alt="" /></div>
              <div class="role">{role}</div>
              <h3 class="rb-h3">{name}</h3>
              <p>{bio}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="rb-sec grain" data-theme="night">
    <div class="rb-wrap rb-split">
      <div>
        <div class="eyebrow">Focus areas</div>
        <h2 class="rb-h2">Uncovering hidden collectible AR.</h2>
        <ul class="rb-list" style="margin-top:28px">
          {
            FOCUS.map((t, i) => (
              <li><span class="n">{String(i + 1).padStart(2, '0')}</span>{t}</li>
            ))
          }
        </ul>
      </div>
      <div>
        <div class="eyebrow">What we deliver</div>
        <h2 class="rb-h2">Five ways in.</h2>
        <ul class="rb-list" style="margin-top:28px">
          {
            DELIVER.map((t, i) => (
              <li><span class="n">{String(i + 1).padStart(2, '0')}</span>{t}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaBand
    title="What is your clinic owed?"
    sub="If you want to understand how much money your clinic is owed and how quickly you can recover it, feel free to reach out."
  />
</Base>
