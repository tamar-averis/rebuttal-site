---
import Base from '../layouts/Base.astro';
import PageHero from '../components/site/PageHero.astro';
import CtaBand from '../components/site/CtaBand.astro';
import Card from '../components/core/Card.astro';
import Badge from '../components/core/Badge.astro';
import Button from '../components/core/Button.astro';
import Tabs from '../components/navigation/Tabs.astro';

const STEPS: [string, string, string][] = [
  ['01', 'Intake', 'The allegation letter, the sample, and the extrapolation method. We start where the payer started.'],
  ['02', 'Extraction', 'Full claims, remittance, and documentation data for the audit period, the whole population, not the sample.'],
  ['03', 'Analysis', 'Line-by-line review against coding rules and clinical documentation, with every determination sourced.'],
  ['04', 'Rebuttal', 'A cited findings packet your counsel can file, plus expert support through appeal.'],
];

const RECEIVE: [string, string][] = [
  ['Findings packet', 'Every cited line, its determination, and the documentation reference.'],
  ['Statistical rebuttal', 'Where the sample fails to support the projection, and by how much.'],
  ['Source manifest', 'A hash-verified index of every file analyzed.'],
  ['Expert support', 'Declarations and testimony through appeal, if it goes that far.'],
];

const ROWS: [string, string, string, string, string][] = [
  ['CLM-0093-221', '99285', 'Emergency, level 5', 'Supported', 'Documentation supports acuity'],
  ['CLM-0093-244', '99284', 'Emergency, level 4', 'Supported', 'Time and MDM documented'],
  ['CLM-0094-018', '99215', 'Office, established', 'In review', 'Awaiting provider note'],
  ['CLM-0094-102', 'J18.9', 'Pneumonia, unspecified', 'Supported', 'Radiology corroborates'],
  ['CLM-0094-311', '99223', 'Inpatient admit', 'Disputed', 'Payer cites missing history'],
  ['CLM-0095-007', '99291', 'Critical care, 30\u201374 min', 'Supported', 'Duration recorded in flowsheet'],
];

const TONE: Record<string, 'supported' | 'neutral' | 'unsupported'> = {
  Supported: 'supported',
  'In review': 'neutral',
  Disputed: 'unsupported',
};

const COMPLIANCE: [string, string][] = [
  [
    'OIG compliance program',
    'The seven elements: written policies, a named compliance officer, training, reporting channels, auditing, enforcement, and corrective action. We help you stand each one up and evidence that it operates.',
  ],
  [
    'HIPAA privacy and security',
    'Risk analysis, administrative and technical safeguards, workforce training, business associate agreements, and breach notification procedures your team can follow without a consultant in the room.',
  ],
  [
    'Coding and billing accuracy',
    'Documentation standards and an internal review cadence, so coding and medical necessity hold up on their own terms long before a payer asks about them.',
  ],
  [
    'Payer contract obligations',
    'Timely filing rules, audit-response duties, and reporting requirements, tracked contract by contract so every obligation has an owner and a date.',
  ],
];
---

<Base
  title="Rebuttal, How it works"
  description="Four steps, one standard: intake, extraction, analysis, and a cited rebuttal packet your counsel can file. Plus compliance requirements we help you implement and monitor."
  page="method"
>
  <PageHero eyebrow="How it works" title="We&rsquo;ve already read every line." wide>
    <p class="rb-sub">
      We work alongside healthcare attorneys to ensure your audit meets the legal requirement to rebuttal. The
      method is fixed so the findings are reproducible: your counsel receives the same artifacts every time, in the
      same order.
    </p>
    <div class="tagline" style="margin-top:72px;color:var(--gold)">Four steps, one standard: everything we assert, we can source.</div>
    <div class="rb-grid4" style="margin-top:28px">
      {
        STEPS.map(([n, t, d]) => (
          <div class="rb-step">
            <div class="n">{n}</div>
            <h3 class="rb-h3" style="margin-top:8px">{t}</h3>
            <p>{d}</p>
          </div>
        ))
      }
    </div>
  </PageHero>

  <section class="rb-sec cream">
    <div class="rb-wrap">
      <div class="eyebrow">What you receive</div>
      <h2 class="rb-h2">The same artifacts, every time, in the same order.</h2>
      <div class="rb-grid4" style="margin-top:40px">
        {
          RECEIVE.map(([t, d]) => (
            <div class="rb-receive">
              <h3 class="rb-h3" style="font-size:20px">{t}</h3>
              <p>{d}</p>
            </div>
          ))
        }
      </div>

      <div style="margin-top:112px">
        <div class="eyebrow">Engagement</div>
        <h2 class="rb-h2">Sixty days, typical.</h2>
        <div class="rb-timeline" role="list">
          <div role="listitem" style="background:var(--cream-200)"><span class="d">Days 1&ndash;5</span><span>Intake and data access</span></div>
          <div role="listitem" style="background:var(--green-100)"><span class="d">Days 6&ndash;20</span><span>Extraction and validation</span></div>
          <div role="listitem" style="background:var(--rebuttal-green);color:var(--cream)"><span class="d">Days 21&ndash;50</span><span>Line-level analysis</span></div>
          <div role="listitem" style="background:var(--gold);color:var(--rebuttal-green)"><span class="d">Days 51&ndash;60</span><span style="font-weight:600">Packet delivered to counsel</span></div>
        </div>
        <p class="small" style="margin-top:16px">This is an average. An engagement can run shorter or longer depending on the matter type.</p>
      </div>
    </div>
  </section>

  <section class="rb-sec grain" data-theme="night">
    <div class="rb-wrap">
      <div class="eyebrow">The evidence</div>
      <h2 class="rb-h2">Here is your rebuttal.</h2>
      <p class="rb-body">An anonymized extract from a commercial payer matter. Every determination links to its source document.</p>
      <div class="rb-table-wrap">
        <div class="rb-table-meta"><span>Commercial payer</span><span>2021&ndash;2023</span><span>6,140 cited lines</span><span>Anonymized</span></div>
        <div style="padding:0 24px">
          <Tabs
            id="evidence"
            tone="dark"
            tabs={[
              { value: 'findings', label: 'Findings', count: 6 },
              { value: 'sampling', label: 'Sampling' },
              { value: 'manifest', label: 'Source manifest' },
            ]}
          >
            <div slot="findings">
              <div class="rb-table-scroll">
                <table class="rb-table">
                  <thead>
                    <tr><th>Claim</th><th>Code</th><th>Description</th><th>Determination</th><th>Basis</th><th>Source document</th></tr>
                  </thead>
                  <tbody>
                    {
                      ROWS.map((r) => (
                        <tr class:list={[r[0] === 'CLM-0095-007' && 'lit']}>
                          <td class="id">{r[0]}</td>
                          <td class="code">{r[1]}</td>
                          <td>{r[2]}</td>
                          <td><Badge tone={TONE[r[3]]}>{r[3]}</Badge></td>
                          <td>{r[4]}</td>
                          <td><a href="#">Open the source document</a></td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>
              <div class="rb-table-foot">
                <span>Showing 6 of 6,140 cited lines</span>
                <Button size="sm" variant="secondary" iconLeft="download">Download packet</Button>
              </div>
            </div>

            <div slot="sampling">
              <div style="padding:32px 24px">
                <h3 class="rb-h3">What the population shows</h3>
                <p class="rb-body" style="margin-top:12px">
                  Error rate in the full cited set is 3.6%, not the 27% the sample implies. The projection does not
                  survive the wider record.
                </p>
                <div style="display:flex;gap:48px;flex-wrap:wrap;margin-top:32px">
                  <div><div class="rb-num" style="font-size:56px;color:var(--gold)">3.6%</div><div class="small" style="margin-top:8px">Error rate, full cited set</div></div>
                  <div><div class="rb-num" style="font-size:56px;color:#A9B5AC">27%</div><div class="small" style="margin-top:8px">Error rate the sample implies</div></div>
                </div>
              </div>
            </div>

            <div slot="manifest">
              <div style="padding:24px">
                <div class="rb-manifest" style="margin-top:0">
                  <span>835 remittance</span><span class="h">sha256:b120&hellip;9ce4</span><span>1,208,441 lines</span>
                  <span>Clinical documentation index</span><span class="h">sha256:77ad&hellip;30f1</span><span>214,882 documents</span>
                </div>
              </div>
            </div>
          </Tabs>
        </div>
      </div>
    </div>
  </section>

  <section class="rb-sec cream">
    <div class="rb-wrap">
      <div class="eyebrow">Compliance</div>
      <h2 class="rb-h2">The strongest rebuttal is a record that was already in order.</h2>
      <p class="rb-body">
        Defending an allegation is where we start, not where we stop. We help you put your compliance requirements
        into practice and keep them there, holding the record to the same standard before a payer asks as we would
        after.
      </p>
      <div class="rb-grid2" style="margin-top:48px;gap:40px 48px">
        {
          COMPLIANCE.map(([t, d]) => (
            <div class="rb-compl">
              <h3 class="rb-h3">{t}</h3>
              <p>{d}</p>
            </div>
          ))
        }
      </div>
      <Card variant="green" padding={40} style="margin-top:64px">
        <h3 class="rb-h3" style="font-size:26px">Implementation is one day. Monitoring is every day after.</h3>
        <p style="font-size:18px;line-height:1.6;color:#CFC8B8;margin-top:14px;max-width:40em">
          We set the review cadence with your team and run it alongside them, keeping the documentation current so
          what you attest to is what the record shows. You stay the owner of your program. We make it provable.
        </p>
      </Card>
    </div>
  </section>

  <CtaBand title="Send us the allegation letter." sub="We will tell you what the data says." />
</Base>
