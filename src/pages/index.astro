---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/site/CtaBand.astro';
import ClaimDocument from '../components/site/ClaimDocument.astro';
import Button from '../components/core/Button.astro';
import Icon from '../components/core/Icon.astro';

const GLANCE: [string, string, boolean?][] = [
  ['Claim lines in the extract', '1,412,908'],
  ['Lines cited by payer', '6,140'],
  ['Supported on the record', '5,918'],
  ['Demand withdrawn', '$18.6M', true],
];

const PILLARS: [string, string][] = [
  ['Every line, not the sample', 'We work from the complete extract, not the payer\u2019s sample: every line, every modifier, every remittance.'],
  ['Evidence, line by line', 'Each disputed line is traced back to the documentation that supports it, and cited.'],
  ['Ready for counsel to file', 'Findings arrive in the form your attorneys file: reproducible, sourced, and defensible under challenge.'],
];

const STATS: [string, string, boolean?][] = [
  ['1M+', 'Claim lines reviewed'],
  ['$100M+', 'Largest exposure defended', true],
];

const AUDIENCE: [string, string][] = [
  ['database', 'Health systems'],
  ['file-text', 'Physician groups'],
  ['shield-check', 'Behavioral health'],
  ['scale', 'Defense counsel'],
  ['line-chart', 'Compliance teams'],
];
---

<Base
  title="Rebuttal, Every clawback deserves a rebuttal."
  description="Rebuttal analyzes healthcare claims data at scale to build the evidence that defends providers against payer overpayment allegations."
  page="home"
>
  <section class="rb-phero grain" data-theme="green">
    <div class="rb-wrap rb-hero-grid">
      <div>
        <h1 class="display rb-h1" style="margin-top:0">Every clawback deserves a rebuttal.</h1>
        <p class="rb-sub">
          When a payer alleges overpayment, we analyze the full claims record and build the evidence your attorneys
          file.
        </p>
        <div class="rb-ctas">
          <Button size="lg" href="/contact">Request an analysis</Button>
          <Button size="lg" variant="secondary" href="/how-it-works">How it works</Button>
        </div>
        <p class="small" style="margin-top:28px">Built with healthcare attorneys &middot; Line-level, defensible, audit-ready</p>
      </div>
      <div class="rb-hero-visual"><ClaimDocument /></div>
    </div>
  </section>

  <section class="rb-sec cream">
    <div class="rb-wrap rb-split">
      <div>
        <div class="eyebrow">The problem</div>
        <h2 class="rb-h2">An allegation is an extrapolation, not a finding.</h2>
        <p class="rb-body">
          Payers sample a few dozen claims, find error, and project it across years of billing. The projection is
          only as sound as the sample. We rebuild the record line by line, the coding, the documentation, the
          medical necessity, and show where the sample does not carry the conclusion.
        </p>
      </div>
      <div class="rb-glance" aria-label="One matter, at a glance">
        <div class="rb-glance-head"><span>One matter, at a glance</span><span>Sample</span></div>
        {
          GLANCE.map(([k, v, lit]) => (
            <div class:list={['rb-glance-row', lit && 'lit']}>
              <span>{k}</span>
              <span class="v">{v}</span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="rb-wrap rb-grid3" style="margin-top:96px">
      {
        PILLARS.map(([t, d]) => (
          <div class="rb-rule">
            <h3 class="rb-h3">{t}</h3>
            <p class="rb-body" style="margin-top:10px;font-size:17px">{d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="rb-sec tight" data-theme="night">
    <div class="rb-wrap rb-stats">
      {
        STATS.map(([n, l, gold]) => (
          <div class="rb-stat">
            <div class:list={['rb-num', gold && 'gold']}>{n}</div>
            <p>{l}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="rb-sec white">
    <div class="rb-wrap">
      <div class="eyebrow">Who we work with</div>
      <h2 class="rb-h2">On the provider&rsquo;s side, and no one else&rsquo;s.</h2>
      <p class="rb-body">
        We do not take payer engagements. Health systems, physician groups, and the law firms defending them are the
        whole of our practice.
      </p>
      <div class="rb-audience">
        {
          AUDIENCE.map(([icon, label]) => (
            <div class="rb-audience-card">
              <Icon name={icon} size={22} color="var(--gold-deep)" />
              <span>{label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand title="Every clawback deserves a rebuttal." sub="Send us the allegation letter. We will tell you what the data says." />
</Base>

<style>
  .rb-audience {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
    margin-top: 32px;
  }

  .rb-audience-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .rb-audience-card span {
    font-size: 15px;
    font-weight: 600;
    color: var(--fg);
  }

  @media (max-width: 900px) {
    .rb-audience {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .rb-audience {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
