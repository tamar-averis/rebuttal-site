---
import Base from '../layouts/Base.astro';
import Icon from '../components/core/Icon.astro';
import Button from '../components/core/Button.astro';
import { INBOX, PHONE, CALENDAR_URL, HUBSPOT_PORTAL_ID, HUBSPOT_FORM_ID, HUBSPOT_REGION } from '../config';
---

<Base
  title="Rebuttal, Contact"
  description="Send us the allegation letter. We will read it and the sampling method, and come back with what we would need to test it."
  page="contact"
>
  <section class="rb-phero grain" data-theme="green">
    <div class="rb-wrap rb-contact-grid">
      <div>
        <div class="eyebrow">Contact</div>
        <h1 class="display rb-h1">Send us the allegation letter.</h1>
        <p class="rb-sub">
          Send it with patient details removed. We will read the letter and the sampling method, and come back with
          what we would need to test it. No cost for the first read.
        </p>
        <div class="rb-contact-lines">
          <a href={`mailto:${INBOX}`}><Icon name="mail" size={20} color="var(--gold)" />{INBOX}</a>
          <a href={`tel:${PHONE.replace(/[^\d+]/g, '')}`}><Icon name="phone" size={20} color="var(--gold)" />{PHONE}</a>
          <span style="display:inline-flex;align-items:center;gap:12px;color:#CFC8B8">
            <Icon name="shield-check" size={20} color="var(--gold)" />HIPAA-compliant intake, BAA on request
          </span>
        </div>
        <div style="margin-top:48px;padding-top:28px;border-top:1px solid var(--green-400)">
          <div class="tagline" style="font-size:20px">Prefer to talk it through first?</div>
          <div style="margin-top:16px">
            <Button variant="secondary" iconLeft="calendar" href={CALENDAR_URL} target="_blank">Book a call</Button>
          </div>
        </div>
      </div>

      <div class="rb-form">
        <div class="rb-h3" style="font-size:22px">Send us the letter</div>
        <script is:inline>
          (function () {
            function getStoredGclid() {
              try {
                var s = JSON.parse(localStorage.getItem('gclid') || 'null');
                if (s && Date.now() - s.t < 90 * 864e5) return s.v;
              } catch (e) {}
              return '';
            }

            // Keep the page URL itself carrying gclid (HubSpot reads the page
            // context on submit), and also try to populate an actual hidden
            // field named gclid on the rendered form, in case the portal maps
            // one. Harmless either way: HubSpot silently drops fields with no
            // matching property instead of rejecting the submission.
            var gclid = getStoredGclid();
            if (gclid) {
              try {
                var url = new URL(location.href);
                if (!url.searchParams.get('gclid')) {
                  url.searchParams.set('gclid', gclid);
                  history.replaceState(null, '', url);
                }
              } catch (e) {}
            }

            window.addEventListener('message', function (event) {
              if (!event.data || event.data.type !== 'hsFormCallback') return;

              if (event.data.eventName === 'onFormReady' && gclid) {
                var frame = document.querySelector('.hs-form-frame');
                var form = frame && frame.querySelector('form');
                if (form && !form.querySelector('input[name="gclid"]')) {
                  var input = document.createElement('input');
                  input.type = 'hidden';
                  input.name = 'gclid';
                  input.value = gclid;
                  form.appendChild(input);
                }
              }

              if (event.data.eventName === 'onFormSubmitted') {
                // Never forward raw submission data, only these three
                // non-identifying fields, and only if the form actually has
                // them under these exact internal names.
                var raw = event.data.data;
                var values = (raw && raw.submissionValues) || {};
                if (Array.isArray(raw)) {
                  raw.forEach(function (f) {
                    if (f && f.name) values[f.name] = f.value;
                  });
                }
                var payload = { event: 'analysis_request_submitted' };
                if (values.payer_type) payload.payer_type = values.payer_type;
                if (values.requester_role) payload.requester_role = values.requester_role;
                if (typeof values.appeal_deadline_set !== 'undefined') {
                  payload.appeal_deadline_set = values.appeal_deadline_set === 'true' || values.appeal_deadline_set === true;
                }
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push(payload);
              }
            });
          })();
        </script>
        <script src={`https://js-na2.hsforms.net/forms/embed/${HUBSPOT_PORTAL_ID}.js`} defer is:inline></script>
        <div
          class="hs-form-frame"
          data-region={HUBSPOT_REGION}
          data-form-id={HUBSPOT_FORM_ID}
          data-portal-id={HUBSPOT_PORTAL_ID}
        >
        </div>
        <div class="rb-phi"><Icon name="lock" size={18} style="margin-top:2px" /><span>Do not send protected health information through this form. We will provide a secure channel at intake.</span></div>
        <p style="font-size:14px;color:var(--cream-500);text-align:center">
          If the form does not load, email us at <a href={`mailto:${INBOX}`} style="color:var(--gold-tagline)">{INBOX}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hs-form-frame {
    min-height: 420px;
  }
</style>
