---
interface Props {
  label?: string;
  /** Right-aligned note beside the label, e.g. "Optional". */
  hint?: string;
  placeholder?: string;
  name?: string;
  id?: string;
  value?: string;
  type?: string;
  required?: boolean;
  disabled?: boolean;
  /** Error message shown beneath; also recolours the border. */
  error?: string;
  /** Static text inside the field's left edge. */
  prefix?: string;
  class?: string;
}

const {
  label,
  hint,
  placeholder,
  name,
  id = name,
  value,
  type = 'text',
  required = false,
  disabled = false,
  error,
  prefix,
  class: className,
} = Astro.props;
---

<div class:list={['field', error && 'field--error', disabled && 'field--disabled', className]}>
  {
    label && (
      <label class="field__label" for={id}>
        {label}
        {hint && <span class="field__hint">{hint}</span>}
      </label>
    )
  }
  <span class:list={['field__control', prefix && 'field__control--with-prefix']}>
    {prefix && <span class="field__prefix">{prefix}</span>}
    <input
      class="field__input"
      type={type}
      id={id}
      name={name}
      placeholder={placeholder}
      value={value}
      required={required}
      disabled={disabled}
      aria-describedby={error ? `${id}-error` : undefined}
    />
  </span>
  {error && <span class="field__error" id={`${id}-error`}>{error}</span>}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field__label {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    font-stretch: var(--stretch-semiexpanded);
    color: var(--fg);
    display: flex;
    justify-content: space-between;
  }

  .field__hint {
    font-weight: 400;
    color: var(--fg-muted);
  }

  .field__control {
    position: relative;
    display: block;
  }

  .field__input {
    width: 100%;
    height: 48px;
    padding: 0 14px;
    font-family: var(--font-sans);
    font-size: 17px;
    color: var(--fg);
    background: var(--surface);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-sm);
    outline: none;
  }

  .field__control--with-prefix .field__input {
    padding-left: 32px;
  }

  .field__prefix {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--fg-muted);
    font-family: var(--font-sans);
    font-size: 17px;
  }

  .field__input:focus-visible {
    border-color: var(--fg);
  }

  .field--error .field__input {
    border-color: var(--risk);
  }

  .field__error {
    font-size: 14px;
    color: var(--risk);
  }

  .field--disabled {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
