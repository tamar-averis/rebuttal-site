---
import Icon from '../core/Icon.astro';

interface Option {
  value: string;
  label: string;
}

interface Props {
  label?: string;
  hint?: string;
  options?: Array<Option | string>;
  name?: string;
  id?: string;
  value?: string;
  disabled?: boolean;
  class?: string;
}

const { label, hint, options = [], name, id = name, value, disabled = false, class: className } = Astro.props;

const normalized: Option[] = options.map((o) => (typeof o === 'string' ? { value: o, label: o } : o));
---

<div class:list={['field', disabled && 'field--disabled', className]}>
  {
    label && (
      <label class="field__label" for={id}>
        {label}
        {hint && <span class="field__hint">{hint}</span>}
      </label>
    )
  }
  <span class="field__control">
    <select class="field__select" id={id} name={name} disabled={disabled}>
      {normalized.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
    </select>
    <Icon name="chevron-down" size={18} class="field__chevron" />
  </span>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field__label {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    font-stretch: var(--stretch-semiexpanded);
    color: var(--fg);
    display: flex;
    justify-content: space-between;
  }

  .field__hint {
    font-weight: 400;
    color: var(--fg-muted);
  }

  .field__control {
    position: relative;
    display: block;
  }

  .field__select {
    width: 100%;
    height: 48px;
    padding: 0 40px 0 14px;
    font-family: var(--font-sans);
    font-size: 17px;
    color: var(--fg);
    background: var(--surface);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-sm);
    outline: none;
    appearance: none;
  }

  .field__chevron {
    position: absolute;
    right: 14px;
    top: 15px;
    color: var(--fg-muted);
    pointer-events: none;
  }

  .field__select:focus-visible {
    border-color: var(--fg);
  }

  .field--disabled {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
