---
/* Site-wide email signup popup. Appears 1s after arrival, once per 30 days
 * (localStorage, same pattern as ConsentBanner and the Averis site's
 * consultation modal). Native <dialog> supplies the focus trap, Escape, and
 * backdrop — no custom a11y code needed for any of that.
 *
 * Styled to match the rest of the site: the same green/grain hero treatment
 * as the homepage band, gold eyebrow, Archivo display heading.
 *
 * The close button is a plain type="button" calling dlg.close(), never a
 * <form method="dialog">: that pattern makes GTM's form-submit trigger fire
 * on every dismissal, inflating lead counts. */
import Icon from '../core/Icon.astro';
import { HUBSPOT_PORTAL_ID, HUBSPOT_REGION, HUBSPOT_EMAIL_SIGNUP_FORM_ID } from '../../config';
---

<dialog id="email-signup-modal" aria-labelledby="email-signup-title">
  <div class="es-head grain" data-theme="green">
    <button type="button" class="es-close" id="email-signup-close" aria-label="Close">
      <Icon name="x" size={16} />
    </button>

    <div class="es-eyebrow-row">
      <span class="es-eyes" aria-hidden="true">
        <Icon name="eye" size={18} />
        <Icon name="eye" size={18} />
      </span>
      <span class="eyebrow" style="color:var(--gold);margin:0">Stay informed</span>
    </div>

    <h2 id="email-signup-title" class="es-title">
      Get notified when we publish new guidance on audits, appeals, and recoupment.
    </h2>
  </div>

  <div class="es-body" id="email-signup-form-wrap">
    <script src={`https://js-na2.hsforms.net/forms/embed/${HUBSPOT_PORTAL_ID}.js`} defer is:inline></script>
    <div
      class="hs-form-frame"
      data-region={HUBSPOT_REGION}
      data-form-id={HUBSPOT_EMAIL_SIGNUP_FORM_ID}
      data-portal-id={HUBSPOT_PORTAL_ID}
    >
    </div>
    <p class="es-microcopy">No spam. Unsubscribe anytime.</p>
  </div>

  <div class="es-body es-body--thanks" id="email-signup-thanks" hidden>
    <div class="es-check" aria-hidden="true"><Icon name="check" size={22} /></div>
    <p class="es-thanks-text">Got it &mdash; we&rsquo;ll email you when new guidance is published.</p>
  </div>
</dialog>

<script>
  (function () {
    var STORAGE_KEY = 'rebuttal-email-popup-seen';
    var DELAY_MS = 1000;
    var REMEMBER_DAYS = 30;

    var dlg = document.getElementById('email-signup-modal') as HTMLDialogElement | null;
    if (!dlg) return;

    function track(payload: Record<string, unknown>) {
      var w = window as Window & { dataLayer?: unknown[] };
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push(payload);
    }

    function alreadySeen() {
      try {
        var s = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
        return !!s && Date.now() - s.t < REMEMBER_DAYS * 864e5;
      } catch (e) {
        return false;
      }
    }

    function remember() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ t: Date.now() }));
      } catch (e) {}
    }

    if (!alreadySeen()) {
      setTimeout(function () {
        if (dlg!.open) return;
        dlg!.showModal();
        track({ event: 'email_popup_shown' });
      }, DELAY_MS);
    }

    document.getElementById('email-signup-close')?.addEventListener('click', function () {
      dlg!.close();
    });

    // Native backdrop click: a click that lands on the <dialog> element
    // itself (not its content) is a click on the backdrop area.
    dlg.addEventListener('click', function (e) {
      if (e.target === dlg) dlg!.close();
    });

    dlg.addEventListener('close', function () {
      remember();
      track({ event: 'email_popup_dismissed' });
    });

    window.addEventListener('message', function (event) {
      if (!event.data || event.data.type !== 'hsFormCallback' || event.data.eventName !== 'onFormSubmitted') return;
      var formWrap = document.getElementById('email-signup-form-wrap');
      var thanks = document.getElementById('email-signup-thanks');
      if (formWrap) formWrap.hidden = true;
      if (thanks) thanks.hidden = false;
      track({ event: 'email_popup_submitted' });
    });
  })();
</script>

<style>
  dialog#email-signup-modal {
    width: min(440px, calc(100vw - 48px));
    border: none;
    border-radius: var(--radius-xl);
    padding: 0;
    overflow: hidden;
    background: var(--white);
    color: var(--rebuttal-green);
    box-shadow: var(--shadow-doc);
  }
  dialog#email-signup-modal::backdrop {
    background: rgba(14, 31, 26, 0.55);
  }
  dialog#email-signup-modal[open] {
    animation: email-modal-in 0.2s var(--ease-entrance);
  }
  @keyframes email-modal-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    dialog#email-signup-modal[open] {
      animation: none;
    }
  }

  .es-head {
    position: relative;
    padding: 30px 32px 26px;
  }

  .es-close {
    position: absolute;
    top: 14px;
    right: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: none;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--cream);
    cursor: pointer;
  }
  .es-close:hover {
    background: rgba(245, 241, 232, 0.14);
  }

  .es-eyebrow-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .es-eyes {
    display: flex;
    align-items: center;
    gap: 2px;
    color: var(--gold);
  }

  .es-title {
    font-family: var(--font-sans);
    font-stretch: var(--stretch-semiexpanded);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.3;
    margin: 12px 24px 0 0;
  }

  .es-body {
    padding: 26px 32px 30px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .es-body--thanks {
    align-items: center;
    text-align: center;
    padding: 40px 32px 44px;
    gap: 12px;
  }

  .es-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    background: var(--gold-100);
    color: var(--gold-700);
  }

  .es-thanks-text {
    font-family: var(--font-sans);
    font-stretch: var(--stretch-semiexpanded);
    font-weight: 600;
    font-size: 19px;
    line-height: 1.35;
    margin: 0;
    max-width: 30ch;
  }

  .hs-form-frame {
    min-height: 110px;
  }

  .es-microcopy {
    font-size: 13px;
    color: var(--cream-500);
    margin: 0;
  }
</style>
