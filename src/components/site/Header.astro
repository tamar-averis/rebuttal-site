---
import Logo from '../core/Logo.astro';
import Button from '../core/Button.astro';
import Icon from '../core/Icon.astro';

interface Props {
  page?: string;
}

const { page } = Astro.props;

const NAV = [
  { id: 'home', label: 'Overview', href: '/' },
  { id: 'method', label: 'How it works', href: '/how-it-works' },
  { id: 'about', label: 'About', href: '/about' },
  { id: 'contact', label: 'Contact', href: '/contact' },
];
---

<header class="rb-header" data-header>
  <div class="rb-wrap">
    <a href="/" class="rb-logo" aria-label="Rebuttal, home"><Logo tone="green" height={40} /></a>
    <nav class="rb-nav" aria-label="Primary">
      {
        NAV.map((n) => (
          <a href={n.href} class="rb-navlink" aria-current={page === n.id ? 'page' : undefined}>
            {n.label}
          </a>
        ))
      }
    </nav>
    <div style="display:flex;gap:8px;align-items:center">
      <span class="rb-book"><Button size="sm" href="/contact">Request an analysis</Button></span>
      <span class="rb-burger">
        <button type="button" class="menu-toggle" aria-label="Open menu" data-menu-toggle>
          <Icon name="menu" size={20} class="menu-toggle__icon menu-toggle__icon--open" />
          <Icon name="x" size={20} class="menu-toggle__icon menu-toggle__icon--close" />
        </button>
      </span>
    </div>
  </div>
  <nav class="rb-mnav" aria-label="Mobile" data-mobile-nav hidden>
    {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
    <div style="margin-top:20px" data-theme="night">
      <Button fullWidth href="/contact">Request an analysis</Button>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-mobile-nav]');
  toggle?.addEventListener('click', () => {
    if (!nav) return;
    const willOpen = nav.hidden;
    nav.hidden = !willOpen;
    toggle.classList.toggle('is-open', willOpen);
    toggle.setAttribute('aria-label', willOpen ? 'Close menu' : 'Open menu');
  });
</script>

<style>
  .rb-burger {
    display: none;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--border-strong);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }

  .menu-toggle__icon--close {
    display: none;
  }

  .menu-toggle.is-open .menu-toggle__icon--open {
    display: none;
  }

  .menu-toggle.is-open .menu-toggle__icon--close {
    display: inline-block;
  }
</style>
