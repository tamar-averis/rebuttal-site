---
import Button from '../core/Button.astro';

interface Props {
  title: string;
  sub?: string;
}

const { title, sub } = Astro.props;
---

<section class="rb-cta grain" data-theme="green">
  <div class="rb-wrap">
    <h2 class="display">{title}</h2>
    {sub && <p class="rb-sub">{sub}</p>}
    <div class="rb-ctas"><Button size="lg" href="/contact">Request an analysis</Button></div>
  </div>
</section>
