---
import Logo from '../core/Logo.astro';

const LEGAL = [
  { label: 'Privacy', href: '/legal/privacy' },
  { label: 'Terms', href: '/legal/terms' },
  { label: 'HIPAA & security', href: '/legal/hipaa-security' },
];
---

<footer class="rb-footer">
  <div class="rb-wrap">
    <div class="rb-footer-grid">
      <div>
        <Logo tone="green" height={30} />
        <div class="eyebrow" style="margin-top:14px">Healthcare Claims Analysis</div>
        <p>
          Rebuttal provides healthcare claims analysis that defends providers against commercial and federal payer
          allegations.
        </p>
      </div>
      <div>
        <div class="eyebrow" style="color:#A9B5AC">Legal</div>
        <div class="rb-footer-legal">
          {LEGAL.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>
    </div>
    <div class="rb-footer-base"><span>&copy; 2026 Rebuttal. rebuttal.health</span><span>We prove you were right.</span></div>
  </div>
</footer>
