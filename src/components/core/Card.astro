---
interface Props {
  variant?: 'flat' | 'green';
  padding?: number;
  class?: string;
  style?: string;
}

const { variant = 'flat', padding = 24, class: className, style } = Astro.props;
---

<div
  class:list={['card', `card--${variant}`, className]}
  style={`--card-padding:${padding}px;${style ?? ''}`}
>
  <slot />
</div>

<style>
  .card {
    border-radius: var(--radius-md);
    padding: var(--card-padding);
    font-family: var(--font-sans);
  }

  .card--flat {
    background: var(--bg-sunken);
    border: 1px solid var(--border);
    color: var(--fg);
  }

  .card--green {
    background: var(--rebuttal-green);
    color: var(--cream);
    border: 1px solid var(--green-400);
    box-shadow: none;
  }
</style>
