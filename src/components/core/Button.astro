---
import Icon from './Icon.astro';

interface Props {
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  fullWidth?: boolean;
  href?: string;
  target?: string;
  type?: 'button' | 'submit' | 'reset';
  iconLeft?: string;
  iconRight?: string;
  id?: string;
  class?: string;
  style?: string;
}

const {
  variant = 'primary',
  size = 'md',
  disabled = false,
  fullWidth = false,
  href,
  target,
  type = 'button',
  iconLeft,
  iconRight,
  id,
  class: className,
  style,
} = Astro.props;

/* A new tab gets noopener so the opened page cannot reach back via window.opener. */
const rel = target === '_blank' ? 'noopener' : undefined;
const iconSize = size === 'sm' ? 14 : size === 'lg' ? 18 : 16;

const classes = ['btn', `btn--${variant}`, `btn--${size}`, fullWidth && 'btn--full', disabled && 'is-disabled', className];
---

{
  href ? (
    <a href={href} target={target} rel={rel} id={id} class:list={classes} style={style} aria-disabled={disabled ? 'true' : undefined}>
      {iconLeft && <Icon name={iconLeft} size={iconSize} />}
      <span><slot /></span>
      {iconRight && <Icon name={iconRight} size={iconSize} />}
    </a>
  ) : (
    <button type={type} id={id} class:list={classes} style={style} disabled={disabled}>
      {iconLeft && <Icon name={iconLeft} size={iconSize} />}
      <span><slot /></span>
      {iconRight && <Icon name={iconRight} size={iconSize} />}
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-stretch: var(--stretch-semiexpanded);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.005em;
    border-radius: var(--radius-sm);
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard);
  }

  .btn--sm {
    height: 36px;
    min-height: 36px;
    padding: 0 14px;
    font-size: 15px;
  }
  .btn--md {
    height: 44px;
    min-height: 44px;
    padding: 0 20px;
    font-size: 16px;
  }
  .btn--lg {
    height: 52px;
    min-height: 44px;
    padding: 0 26px;
    font-size: 17px;
  }
  .btn--full {
    display: flex;
    width: 100%;
  }

  .btn--primary {
    color: var(--rebuttal-green);
    background: var(--gold);
    border: 1.5px solid transparent;
  }
  .btn--primary:hover {
    background: var(--accent-hover);
  }

  .btn--secondary {
    color: var(--fg);
    background: transparent;
    border: 1.5px solid var(--fg);
  }
  .btn--secondary:hover {
    background: var(--accent-bg);
  }

  .btn.is-disabled,
  .btn:disabled {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
