---
import Icon from './Icon.astro';

interface Props {
  name: string;
  /** Accessible label: required, the button has no text. */
  label: string;
  variant?: 'outline' | 'ghost';
  disabled?: boolean;
  class?: string;
}

const { name, label, variant = 'outline', disabled = false, class: className } = Astro.props;
---

<button
  type="button"
  aria-label={label}
  disabled={disabled}
  class:list={['icon-btn', `icon-btn--${variant}`, className]}
>
  <Icon name={name} size={20} />
</button>

<style>
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-standard);
  }

  .icon-btn--outline {
    border: 1.5px solid var(--border-strong);
  }

  .icon-btn--ghost {
    border: 1.5px solid transparent;
  }

  .icon-btn:hover {
    background: var(--accent-bg);
  }

  .icon-btn:disabled {
    opacity: 0.42;
    pointer-events: none;
  }
</style>
