---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['tag', className]}>
  <slot />
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: 14px;
    cursor: default;
  }
</style>
