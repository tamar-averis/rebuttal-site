---
interface Props {
  /** Which surface the logo sits on — picks the cream-on-green or green-on-white lockup. */
  tone?: 'green' | 'white';
  /** Rendered height in px; width scales from it automatically. */
  height?: number;
  /** Renders only the claw mark (favicon / avatar use). */
  markOnly?: boolean;
  class?: string;
  style?: string;
}

const { tone = 'green', height = 34, markOnly = false, class: className, style } = Astro.props;

// Full lockup is cropped to 776.4x198; the mark-only symbol is cropped to 64x64.
const ratio = markOnly ? 1 : 776.4 / 198;
const src = markOnly ? `/assets/symbol-on-${tone}.svg` : `/assets/logo-on-${tone}.svg`;
---

<img
  src={src}
  alt={markOnly ? '' : 'Rebuttal'}
  height={height}
  width={height * ratio}
  class:list={['logo', className]}
  style={style}
/>

<style>
  .logo {
    display: block;
  }
</style>
