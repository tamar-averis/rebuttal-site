---
interface Props {
  variant?: 'primary' | 'reversed';
  /** Adds the "Healthcare Claims Analysis" category line beneath. */
  descriptor?: boolean;
  /** Rendered height in px; width scales from it automatically. */
  height?: number;
  /** Renders only the mountain mark (favicon / avatar use). */
  markOnly?: boolean;
  class?: string;
}

const { variant = 'primary', descriptor = false, height = 34, markOnly = false, class: className } = Astro.props;

const dark = variant === 'reversed';

// Full lockup is 776.4x198; the mark-only symbol is a 64x64 square.
const ratio = markOnly ? 1 : 776.4 / 198;
const src = markOnly
  ? dark
    ? '/assets/mark-reversed.svg'
    : '/assets/mark-primary.svg'
  : dark
    ? '/assets/logo-reversed.svg'
    : '/assets/logo-primary.svg';
---

<span class:list={['logo', descriptor && 'logo--stacked', className]}>
  <img src={src} alt={markOnly ? '' : 'Rebuttal'} height={height} width={height * ratio} class="logo__img" />
  {descriptor && !markOnly && <span class:list={['logo__descriptor', dark && 'logo__descriptor--reversed']}>Healthcare Claims Analysis</span>}
</span>

<style>
  .logo {
    display: inline-flex;
  }

  .logo--stacked {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .logo__img {
    display: block;
  }

  .logo__descriptor {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--text-nano);
    text-transform: uppercase;
    letter-spacing: var(--tracking-catline);
    color: #6a7c74;
  }

  .logo__descriptor--reversed {
    color: var(--text-on-inverse-mute);
  }
</style>
