---
interface Props {
  tone?: 'supported' | 'neutral' | 'unsupported';
  class?: string;
}

const { tone = 'neutral', class: className } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, className]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 10px;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-stretch: var(--stretch-semiexpanded);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .badge--supported {
    background: var(--success-bg);
    color: var(--success);
  }
  .badge--neutral {
    background: var(--bg-sunken);
    color: var(--fg);
  }
  .badge--unsupported {
    background: var(--risk-bg);
    color: var(--risk);
  }
</style>
